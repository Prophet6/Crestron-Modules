[BEGIN]
  ObjTp=Hd
  Cmn1=EtherGate Channel v1.0\\\\DMX loads on the gateway selected by Controller.
  Cmn2=||1One row is one load.\\Expand the row for each additional load,||1
  Cmn3=up to 64.\\\\Port is 1 or 2 for every load on this symbol.\\Controller_Override||1
  Cmn4=is ignored until an analog value arrives.\\After that, 1-8 selects||1
  Cmn5=that slot.\\\\Channel is percent. 0 is off and 65535 is DMX 255.
  Cmn6=\\Channel_ID on that same row is the DMX address, 1-512.\\Channel_FB||1
  Cmn7=follows the live value, including while a preset is fading.\\\\This||1
  Cmn8=symbol subscribes only to its own port and addresses. A level\\change||1
  Cmn9=on another load does not run these rows.
[END]
