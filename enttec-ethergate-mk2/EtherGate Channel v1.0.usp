#HELP_BEGIN
EtherGate Channel v1.0

DMX loads on the gateway selected by Controller. One row is one load.
Expand the row for each additional load, up to 64.

Port is 1 or 2 for every load on this symbol.
Controller_Override is ignored until an analog value arrives.
After that, 1-8 selects that slot.

Channel is percent. 0 is off and 65535 is DMX 255.
Channel_ID on that same row is the DMX address, 1-512.
Channel_FB follows the live value, including while a preset is fading.

This symbol subscribes only to its own port and addresses. A level
change on another load does not run these rows.
#HELP_END

#SYMBOL_NAME "Enttec EtherGate Channel v1.0"
#HELP_PDF_FILE "EtherGate v1.html"
#CATEGORY "46" "DMX" // Custom
#DEFAULT_VOLATILE
#ENABLE_DYNAMIC
#ENABLE_STACK_CHECKING
#ANALOG_SERIAL_EXPAND AllWithAny
#USER_SIMPLSHARP_LIBRARY "EtherGate_v1"

#DEFINE_CONSTANT MaxChannels 64

/* Row 1  Port
 * Row 2  Controller_Override, Controller
 * Row 3  blank
 * Row 4+ Channel, Channel_ID, Channel_FB  (expand together)
 */

ANALOG_INPUT	_SKIP_, Controller_Override, _SKIP_, Channel[MaxChannels,1];
ANALOG_OUTPUT	_SKIP_, _SKIP_, _SKIP_, Channel_FB[MaxChannels,1];

INTEGER_PARAMETER	Port, Controller, _SKIP_, Channel_ID[MaxChannels,1];

#BEGIN_PARAMETER_PROPERTIES Port
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propDefaultValue =		1d;
	propList =				{1d, "Port 1"},
							{2d, "Port 2"};
	propShortDescription =	"DMX port on the EtherGate";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Channel_ID
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propBounds =			1d, 512d;
	propDefaultValue =		1d;
	propShortDescription =	"DMX address for this row (1-512)";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Controller
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propDefaultValue =		1d;
	propList =				{1d, "Controller 1"},
							{2d, "Controller 2"},
							{3d, "Controller 3"},
							{4d, "Controller 4"},
							{5d, "Controller 5"},
							{6d, "Controller 6"},
							{7d, "Controller 7"},
							{8d, "Controller 8"};
	propShortDescription =	"Which EtherGate this symbol uses";
#END_PARAMETER_PROPERTIES

INTEGER Ready, SessionReady, CurrentSlot, ControllerLatch, Hooked[MaxChannels];
EtherGateChannelBind Bind[MaxChannels];

INTEGER_FUNCTION ResolveSlot () {
	INTEGER s;

	If (ControllerLatch = 1)
		s = Controller_Override;
	Else
		s = Controller;

	If (s < 1)
		s = 1;
	If (s > 8)
		s = 8;
	return (s);
}

FUNCTION BindRow (INTEGER i, INTEGER s) {
	INTEGER addr;
	EtherGateChannelBind row;

	row = Bind[i];
	addr = Channel_ID[i];
	If (addr < 1)
		addr = 1;
	If (addr > 512)
		addr = 512;
	If (Hooked[i] = 0) {
		row.SetIndex(i);
		RegisterDelegate(row, OnLevelChanged, HandleLevel);
		Hooked[i] = 1;
	}
	row.Use(s, Port, addr);
	row.Publish();
}

FUNCTION OpenSession () {
	INTEGER s, i;

	s = ResolveSlot();
	For (i = 1 to MaxChannels) {
		If (IsSignalDefined(Channel[i]))
			BindRow(i, s);
	}
}

FUNCTION PushLevel (INTEGER i) {
	EtherGateChannelBind row;

	If (IsSignalDefined(Channel[i])) {
		row = Bind[i];
		row.SetLevel(Channel[i]);
	}
}

FUNCTION PushLevels () {
	INTEGER i;

	For (i = 1 to MaxChannels)
		PushLevel(i);
}

CALLBACK FUNCTION HandleLevel (INTEGER index, INTEGER percent) {
	If (IsSignalDefined(Channel_FB[index]))
		Channel_FB[index] = percent;
}

CHANGE Controller_Override {
	If (Ready = 1) {
		ControllerLatch = 1;
		OpenSession();
		PushLevels();
	}
}

CHANGE Channel {
	INTEGER i;

	If (Ready = 1) {
		i = GetLastModifiedArrayIndex();
		If (i >= 1) {
			If (i <= MaxChannels)
				PushLevel(i);
		}
	}
}

FUNCTION Main () {
	OpenSession();
	WaitForInitializationComplete();
	Ready = 1;
	PushLevels();
}
