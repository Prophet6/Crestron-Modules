#HELP_BEGIN
EtherGate Preset v1.0

Presets for the Channel rows registered on the selected EtherGate.
The gateway does not store presets. This module does.

Eight rows. Each row is one preset button.
Preset, Preset_No, and Preset_FB share that row.
AllWithAny keeps those three together.

Preset replaces Recall and Save. From the rising edge, in 0.1s steps:
  Press high                  Preset_FB high, until a blink
  release before Hold_Time    recall
  hold for Hold_Time          save, then blink Preset_FB
  still held at 10s           erase

Hold_Time is how long the press must be held to save.
Default 2.5s, range 0.5s to 9.0s. Time or ticks. 1t = 0.01s.
Confirmation_Time is the total save blink, shared by every row.

Preset_No on the row is which stored preset that button uses.
0 is off, and that row does nothing. 1 through 64 select that preset.
Preset_Trigger recalls any of those 64 by number, using this symbol's
fade and channel list. 0 does nothing. It does not save or erase.
Return it to 0 before sending the same number again.
Preset_Save stores any of those 64 by number, using this symbol's
channel list. 0 does nothing. It does not recall or erase.
Return it to 0 before sending the same number again.
A value present at startup waits until the analog changes.

Fade_Time is seconds on the symbol (0.5s is half a second, 0 is
a cut). Fade_Time_Override is tenths of a second. It is ignored
until an analog value arrives. After that, the analog is the fade,
and 0 is a cut. 5 is 0.5 seconds. 50 is 5.0 seconds.

Channels is the comma-separated list this symbol controls.
Empty means every defined channel. 12 is channel 12 on either
port. 1:12 is port 1 channel 12, and 2:12 is port 2. Spaces
around commas are ignored. A token that is not a channel is
skipped. 255 characters.
Channels_Override$ is ignored until a string arrives. After that,
the serial is the list, and an empty serial means every channel.
Save with a list writes those channels and leaves the others
stored. Recall moves only stored channels in the list. A 10s
hold removes those channels. An empty list saves every defined
channel, replacing the preset, and a 10s hold clears it.

Controller_Override is ignored until an analog value arrives. After that,
1-8 selects that slot.
#HELP_END

#SYMBOL_NAME "Enttec EtherGate Preset v1.0"
#HELP_PDF_FILE "EtherGate v1.html"
#CATEGORY "46" "DMX" // Custom
#DEFAULT_VOLATILE
#ENABLE_DYNAMIC
#ENABLE_STACK_CHECKING
#DIGITAL_EXPAND AllWithAny
#ANALOG_SERIAL_EXPAND AllWithAny
#USER_SIMPLSHARP_LIBRARY "EtherGate_v1"

#DEFINE_CONSTANT MaxPresets 8
#DEFINE_CONSTANT MaxStored 64
#DEFINE_CONSTANT EraseAt 100
#DEFINE_CONSTANT BlinkSteps 6

/* Rows 1-2   Hold_Time, Confirmation_Time
 * Rows 3-10  Preset, Preset_No, Preset_FB
 * Row 11     blank
 * Row 12     Preset_Trigger
 * Row 13     Preset_Save
 * Row 14     blank
 * Row 15     Fade_Time with Fade_Time_Override
 * Row 16     Channels with Channels_Override$
 * Row 17     blank
 * Row 18     Controller with Controller_Override
 */

DIGITAL_INPUT	_SKIP_, _SKIP_, Preset[MaxPresets,8];
DIGITAL_OUTPUT	_SKIP_, _SKIP_, Preset_FB[MaxPresets,8];

ANALOG_INPUT	_SKIP_, Preset_Trigger, Preset_Save, _SKIP_, Fade_Time_Override;
STRING_INPUT	Channels_Override$[255];
ANALOG_INPUT	_SKIP_, Controller_Override;

INTEGER_PARAMETER	Hold_Time, Confirmation_Time, Preset_No[MaxPresets,8], _SKIP_, _SKIP_, _SKIP_, _SKIP_, Fade_Time;
STRING_PARAMETER	Channels[255];
INTEGER_PARAMETER	_SKIP_, Controller;

#BEGIN_PARAMETER_PROPERTIES Hold_Time
	propValidUnits =		unitTime|unitTicks;
	propDefaultUnit =		unitTime;
	propBounds =			0.5s, 9.0s;
	propDefaultValue =		2.5s;
	propShortDescription =	"Hold before save";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Confirmation_Time
	propValidUnits =		unitTime|unitTicks;
	propDefaultUnit =		unitTime;
	propDefaultValue =		1.2s;
	propList =				{0.6s, "0.6s"},
							{1.2s, "1.2s"},
							{1.8s, "1.8s"},
							{2.4s, "2.4s"},
							{3.0s, "3.0s"};
	propShortDescription =	"Total save-confirmation blink";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Preset_No
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propBounds =			0d, 64d;
	propDefaultValue =		0d;
	propShortDescription =	"Preset number for this row. 0 is off";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Fade_Time
	propValidUnits =		unitTime;
	propDefaultUnit =		unitTime;
	propBounds =			0.0s, 600.0s;
	propDefaultValue =		0.0s;
	propShortDescription =	"Fade time in seconds. 0 is a cut";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Channels
	propValidUnits =		unitString;
	propDefaultUnit =		unitString;
	propDefaultValue =		"";
	propShortDescription =	"Channels to control. Empty is all";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Controller
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propDefaultValue =		1d;
	propList =				{1d, "Controller 1"},
							{2d, "Controller 2"},
							{3d, "Controller 3"},
							{4d, "Controller 4"},
							{5d, "Controller 5"},
							{6d, "Controller 6"},
							{7d, "Controller 7"},
							{8d, "Controller 8"};
	propShortDescription =	"Which EtherGate this symbol uses";
#END_PARAMETER_PROPERTIES

INTEGER Ready, SessionReady, CurrentSlot, FadeLatch, ChannelsLatch, ControllerLatch,
        KeepTick, Hooked[MaxPresets], Match[MaxPresets], Elapsed[MaxPresets],
        DidSave[MaxPresets], BlinkEdges[MaxPresets], BlinkLevel[MaxPresets],
        BlinkAccum[MaxPresets];
EtherGatePresetBind Bind[MaxPresets], Trigger;

INTEGER_FUNCTION ResolveSlot () {
	INTEGER s;

	If (ControllerLatch = 1)
		s = Controller_Override;
	Else
		s = Controller;

	If (s < 1)
		s = 1;
	If (s > 8)
		s = 8;
	return (s);
}

INTEGER_FUNCTION ResolveRowPreset (INTEGER i) {
	INTEGER p;

	p = Preset_No[i];
	If (p < 0)
		p = 0;
	If (p > MaxStored)
		p = MaxStored;
	return (p);
}

INTEGER_FUNCTION ResolveFade () {
	INTEGER t;

	If (FadeLatch = 1)
		t = Fade_Time_Override;
	Else
		t = Fade_Time / 10;

	If (t < 0)
		t = 0;
	If (t > 6000)
		t = 6000;
	return (t);
}

FUNCTION ApplyChannels () {
	STRING list$[255];
	INTEGER i;
	EtherGatePresetBind row;

	If (ChannelsLatch = 1)
		list$ = Channels_Override$;
	Else
		list$ = Channels;
	Trigger.SetChannels(list$);
	For (i = 1 to MaxPresets) {
		If (IsSignalDefined(Preset[i])) {
			row = Bind[i];
			row.SetChannels(list$);
		}
	}
}

FUNCTION ApplyFeedback (INTEGER i) {
	If (BlinkEdges[i] > 0)
		Preset_FB[i] = BlinkLevel[i];
	Else If (Preset[i] = 1)
		Preset_FB[i] = 1;
	Else
		Preset_FB[i] = (Match[i] = 1);
}

FUNCTION ClearBlink (INTEGER i) {
	BlinkEdges[i] = 0;
	BlinkLevel[i] = 0;
	BlinkAccum[i] = 0;
}

FUNCTION BeginBlink (INTEGER i) {
	BlinkEdges[i] = BlinkSteps;
	BlinkLevel[i] = 0;
	BlinkAccum[i] = 0;
	Preset_FB[i] = 0;
}

FUNCTION AdvanceBlink (INTEGER i) {
	INTEGER ticks;

	If (BlinkEdges[i] = 0)
		Return;
	BlinkAccum[i] = BlinkAccum[i] + 1;
	/* Hundredths, split across the steps, then counted in 0.1 s ticks */
	ticks = Confirmation_Time / 10;
	ticks = ticks / BlinkSteps;
	If (ticks < 1)
		ticks = 1;
	If (BlinkAccum[i] < ticks)
		Return;
	BlinkAccum[i] = 0;
	If (BlinkEdges[i] > 1) {
		BlinkEdges[i] = BlinkEdges[i] - 1;
		If (BlinkLevel[i] = 0)
			BlinkLevel[i] = 1;
		Else
			BlinkLevel[i] = 0;
		Preset_FB[i] = BlinkLevel[i];
	}
	Else {
		BlinkEdges[i] = 0;
		BlinkLevel[i] = 0;
		ApplyFeedback(i);
	}
}

FUNCTION TickRow (INTEGER i) {
	INTEGER started;
	EtherGatePresetBind row;

	started = 0;
	If (Preset_No[i] < 1)
		Return;
	If (Preset[i] = 1) {
		Elapsed[i] = Elapsed[i] + 1;
		/* Time and ticks are both hundredths; each step here is 0.1 s */
		If ((DidSave[i] = 0) && (Elapsed[i] >= (Hold_Time / 10))) {
			DidSave[i] = 1;
			row = Bind[i];
			row.Save();
			BeginBlink(i);
			started = 1;
		}
		If (Elapsed[i] = EraseAt) {
			DidSave[i] = 1;
			ClearBlink(i);
			row = Bind[i];
			row.Erase();
		}
		Else {
			KeepTick = 1;
		}
	}
	If ((BlinkEdges[i] > 0) && (started = 0)) {
		AdvanceBlink(i);
		KeepTick = 1;
	}
}

FUNCTION OnTick () {
	INTEGER i;

	KeepTick = 0;
	For (i = 1 to MaxPresets) {
		If (IsSignalDefined(Preset[i]))
			TickRow(i);
	}
}

FUNCTION ArmTick () {
	Wait (10, Tick) {
		OnTick();
		If (KeepTick = 1)
			ArmTick();
	}
}

FUNCTION BeginPress (INTEGER i) {
	If (Preset_No[i] < 1)
		Return;
	Elapsed[i] = 0;
	DidSave[i] = 0;
	ClearBlink(i);
	ApplyFeedback(i);
	If (KeepTick = 0) {
		KeepTick = 1;
		ArmTick();
	}
}

FUNCTION EndPress (INTEGER i) {
	EtherGatePresetBind row;

	If (Preset_No[i] < 1)
		Return;
	If (DidSave[i] = 0) {
		row = Bind[i];
		row.Recall(ResolveFade());
	}
	ApplyFeedback(i);
}

FUNCTION OpenSession () {
	INTEGER s, i;
	EtherGatePresetBind row;

	s = ResolveSlot();
	ApplyChannels();
	For (i = 1 to MaxPresets) {
		If (IsSignalDefined(Preset[i])) {
			row = Bind[i];
			If (Hooked[i] = 0) {
				row.SetRow(i);
				RegisterDelegate(row, OnActiveChanged, HandleActive);
				Hooked[i] = 1;
			}
			If (ResolveRowPreset(i) > 0) {
				row.Use(s, ResolveRowPreset(i));
				row.Publish();
				If (Ready = 1) {
					If (Preset[i] = 1)
						BeginPress(i);
					Else
						ApplyFeedback(i);
				}
			}
			Else {
				Match[i] = 0;
				ClearBlink(i);
				Preset_FB[i] = 0;
			}
		}
	}
}

FUNCTION FireTrigger () {
	INTEGER p, s;
	STRING list$[255];

	p = Preset_Trigger;
	If (p < 1)
		Return;
	If (p > MaxStored)
		Return;
	s = ResolveSlot();
	If (ChannelsLatch = 1)
		list$ = Channels_Override$;
	Else
		list$ = Channels;
	Trigger.SetChannels(list$);
	Trigger.Use(s, p);
	Trigger.Recall(ResolveFade());
}

FUNCTION FireSave () {
	INTEGER p, s;
	STRING list$[255];

	p = Preset_Save;
	If (p < 1)
		Return;
	If (p > MaxStored)
		Return;
	s = ResolveSlot();
	If (ChannelsLatch = 1)
		list$ = Channels_Override$;
	Else
		list$ = Channels;
	Trigger.SetChannels(list$);
	Trigger.Use(s, p);
	Trigger.Save();
}

CALLBACK FUNCTION HandleActive (INTEGER index, INTEGER active) {
	If (index >= 1) {
		If (index <= MaxPresets) {
			Match[index] = active;
			ApplyFeedback(index);
		}
	}
}

PUSH Preset {
	INTEGER i;

	If (Ready = 1) {
		i = GetLastModifiedArrayIndex();
		If (i >= 1) {
			If (i <= MaxPresets)
				BeginPress(i);
		}
	}
}

RELEASE Preset {
	INTEGER i;

	If (Ready = 1) {
		i = GetLastModifiedArrayIndex();
		If (i >= 1) {
			If (i <= MaxPresets)
				EndPress(i);
		}
	}
}

CHANGE Preset_Trigger {
	If (Ready = 1)
		FireTrigger();
}

CHANGE Preset_Save {
	If (Ready = 1)
		FireSave();
}

CHANGE Fade_Time_Override {
	If (Ready = 1)
		FadeLatch = 1;
}

CHANGE Channels_Override$ {
	INTEGER i;
	EtherGatePresetBind row;

	If (Ready = 1) {
		ChannelsLatch = 1;
		ApplyChannels();
		For (i = 1 to MaxPresets) {
			If (IsSignalDefined(Preset[i])) {
				row = Bind[i];
				row.Publish();
			}
		}
	}
}

CHANGE Controller_Override {
	If (Ready = 1) {
		ControllerLatch = 1;
		OpenSession();
	}
}

FUNCTION Main () {
	OpenSession();
	WaitForInitializationComplete();
	Ready = 1;
	FireTrigger();
}
