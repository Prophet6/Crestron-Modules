[BEGIN]
  ObjTp=Dp
  H=4
  Tp=1
  SD=IV-CAM picture. Default is 2.
  FD1=		1 is the PTZ picture. 2 is the fixed reference camera.\\
  FD2=		On an IV-CAM-I12D-B, 1 and 2 are the PTZ lenses and 3 is the reference.\\
  FD3=		Ignored when Path is set.
