[BEGIN]
  ObjTp=Hd
  Cmn1=IV-CAM PTZ Presets v1.0\\\\Expandable buttons for the presets on||1
  Cmn2=IV-CAM PTZ v1.0.\\\\Press[n] recalls camera preset n. Holding it||1
  Cmn3=for Hold_Time stores that preset.\\Press[1] is preset 1. The symbol||1
  Cmn4=starts with one button and expands to 32.\\\\One preset runs at||1
  Cmn5=a time. A new press cancels the press already in progress.\\Releasing||1
  Cmn6=the cancelled button does nothing.\\\\Press_FB[n] follows Press[n].
  Cmn7=||1After a store it drops for Blink_Time, then\\follows the button||1
  Cmn8=again. That drop is the store confirmation.\\\\Preset_Trigger recalls||1
  Cmn9=preset 0 through 255 when the analog changes.\\The value sitting||1
  Cmn10=on it at startup waits for the next change.\\Send a different number||1
  Cmn11=before sending the same number again.\\A value above 255 is sent||1
  Cmn12=as 255.\\Preset 0 is a camera memory. Home on IV-CAM PTZ is a different||1
  Cmn13=command.\\\\Wire this symbol to IV-CAM PTZ v1.0:\\  Store   -> Store_Preset\\
  Cmn14=||2Recall  -> Recall_Preset\\  Preset  -> Preset\\\\Store and Recall||1
  Cmn15=pulse on each recall or store. Preset changes to the\\preset number||1
  Cmn16=before that pulse.\\\\Hold_Time default is 3s, range 0.5s to 10s.
  Cmn17=\\Blink_Time default is 0.5s, range 0s to 5s. At 0s, Press_FB stays||1
  Cmn18=with\\the button through the store.\\\\Rows:\\  1  Hold_Time\\||2
  Cmn19=2  Blink_Time\\  3  Store\\  4  Recall\\  5  blank\\  6+ Press[n]||1
  Cmn20=beside Press_FB[n]\\  blank\\  Preset_Trigger beside Preset\\  Adding||1
  Cmn21=a button moves the blank row and Preset_Trigger down.\\  Hold_Time,||1
  Cmn22=Blink_Time, Store, and Recall stay on the first rows.\\\\v1.0  2026-
  Cmn23=11-06\\- Press recalls, hold stores, feedback drops to confirm a||1
  Cmn24=store\\- One wait. A new press cancels the press already in progress\\
  Cmn25=- Preset_Trigger recalls by number
[END]
