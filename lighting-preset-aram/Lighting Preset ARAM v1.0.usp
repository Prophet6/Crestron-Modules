#HELP_BEGIN
Lighting Preset ARAM v1.0
Stores and recalls 16 analog values for 6 lighting presets.
The values live in this module. They are nonvolatile.

Each preset N (1-6) is one group of three rows:
  [D]PresetN_Recall   panel Lighting.PresetNRecall (short press)
  [D]PresetN_Save     panel Lighting.PresetNSave (held the whole press)
  [D]PresetN_FB       panel Lighting.PresetN

A blank row follows the six presets. Under that, set both
analog arrays to the same size (16 to use every channel):
  [A]Ain1-Ain16       live values to store and compare
  [A]Aout1-Aout16     values driven on recall

Only an Ain with a signal on it is stored, compared, or recalled.
Ain and Aout on the same row cannot share one signal name.

PresetN_Save is timed from its rising edge. Releasing it cancels
whichever timer has not finished.
  2.5 seconds   stores every defined Ain into preset N
  10 seconds    erases preset N (stored values return to 0)

PresetN_Recall copies that preset onto the defined Aout channels.
An empty or erased preset does not drive the outputs.

PresetN_FB is high only when that preset has been stored and
every defined analog equals it. A defined analog is one with a
signal on Ain or Aout. More than one preset may match.

A recall makes those analogs the current values and checks
immediately. Any later Ain change drops every PresetN_FB. After
the inputs sit still for about 1 second, the check runs again.

Erase, and a never-stored preset, stay dark. A look that was
saved at zero still matches when the live values are zero.
#HELP_END

#CATEGORY "12" /* System Control */
#DEFAULT_VOLATILE

/* INPUTS & OUTPUTS */

DIGITAL_INPUT	Preset1_Recall, Preset1_Save, _SKIP_,
				Preset2_Recall, Preset2_Save, _SKIP_,
				Preset3_Recall, Preset3_Save, _SKIP_,
				Preset4_Recall, Preset4_Save, _SKIP_,
				Preset5_Recall, Preset5_Save, _SKIP_,
				Preset6_Recall, Preset6_Save, _SKIP_,
				_SKIP_;

DIGITAL_OUTPUT	Preset1_FB, _SKIP_, _SKIP_,
				Preset2_FB, _SKIP_, _SKIP_,
				Preset3_FB, _SKIP_, _SKIP_,
				Preset4_FB, _SKIP_, _SKIP_,
				Preset5_FB, _SKIP_, _SKIP_,
				Preset6_FB, _SKIP_, _SKIP_,
				_SKIP_;

ANALOG_INPUT	Ain[16];
ANALOG_OUTPUT	Aout[16];

/* GLOBAL VARIABLES */

NONVOLATILE LONG_INTEGER Stored[6][16];
NONVOLATILE INTEGER Kept[6];
LONG_INTEGER Live[16];
INTEGER Driving;

/* LOGIC */

FUNCTION ClearFeedback()
{
	Preset1_FB = 0;
	Preset2_FB = 0;
	Preset3_FB = 0;
	Preset4_FB = 0;
	Preset5_FB = 0;
	Preset6_FB = 0;
}

FUNCTION SetFeedback(INTEGER which, INTEGER level)
{
	if (which = 1)
		Preset1_FB = level;
	else if (which = 2)
		Preset2_FB = level;
	else if (which = 3)
		Preset3_FB = level;
	else if (which = 4)
		Preset4_FB = level;
	else if (which = 5)
		Preset5_FB = level;
	else if (which = 6)
		Preset6_FB = level;
}

INTEGER_FUNCTION ChannelDefined(INTEGER channel)
{
	if (IsSignalDefined(Ain[channel]))
		return(1);
	if (IsSignalDefined(Aout[channel]))
		return(1);
	return(0);
}

/*
 * Copy Ain into the live image. Returns 1 when a defined input
 * actually moved. An echo of a value recall just drove is not a move.
 */
INTEGER_FUNCTION SyncLive()
{
	INTEGER channel;
	INTEGER changed;
	LONG_INTEGER sample;

	changed = 0;
	for (channel = 1 to 16)
	{
		if (IsSignalDefined(Ain[channel]))
		{
			sample = Ain[channel];
			if (Live[channel - 1] <> sample)
			{
				Live[channel - 1] = sample;
				changed = 1;
			}
		}
	}
	return(changed);
}

INTEGER_FUNCTION PresetMatches(INTEGER which)
{
	INTEGER channel;
	INTEGER slot;
	INTEGER saw;

	slot = which - 1;
	if (Kept[slot] = 0)
		return(0);

	saw = 0;
	for (channel = 1 to 16)
	{
		if (ChannelDefined(channel))
		{
			saw = 1;
			if (Stored[slot][channel - 1] <> Live[channel - 1])
				return(0);
		}
	}

	return(saw);
}

FUNCTION MatchPresets()
{
	INTEGER which;

	for (which = 1 to 6)
		SetFeedback(which, PresetMatches(which));
}

FUNCTION Store(INTEGER which)
{
	INTEGER channel;
	INTEGER index;

	index = which - 1;
	SyncLive();
	for (channel = 1 to 16)
	{
		if (ChannelDefined(channel))
			Stored[index][channel - 1] = Live[channel - 1];
		else
			Stored[index][channel - 1] = 0;
	}
	Kept[index] = 1;
	MatchPresets();
}

FUNCTION Erase(INTEGER which)
{
	INTEGER channel;
	INTEGER index;

	index = which - 1;
	for (channel = 1 to 16)
		Stored[index][channel - 1] = 0;
	Kept[index] = 0;
	MatchPresets();
}

FUNCTION Recall(INTEGER which)
{
	INTEGER channel;
	INTEGER index;

	index = which - 1;
	if (Kept[index] = 1)
	{
		Driving = 1;
		for (channel = 1 to 16)
		{
			if (ChannelDefined(channel))
			{
				Live[channel - 1] = Stored[index][channel - 1];
				if (IsSignalDefined(Aout[channel]))
					Aout[channel] = Live[channel - 1];
			}
		}
		ProcessLogic();
		Driving = 0;
		MatchPresets();
	}
}

/*
 * Save is held for the whole press.
 * Wait times are hundredths of a second: 250 = 2.5s, 1000 = 10s.
 * Release cancels a timer that has not finished.
 */
PUSH Preset1_Save
{
	Wait(250, Store1) { Store(1); }
	Wait(1000, Erase1) { Erase(1); }
}
RELEASE Preset1_Save
{
	CancelWait(Store1);
	CancelWait(Erase1);
}

PUSH Preset2_Save
{
	Wait(250, Store2) { Store(2); }
	Wait(1000, Erase2) { Erase(2); }
}
RELEASE Preset2_Save
{
	CancelWait(Store2);
	CancelWait(Erase2);
}

PUSH Preset3_Save
{
	Wait(250, Store3) { Store(3); }
	Wait(1000, Erase3) { Erase(3); }
}
RELEASE Preset3_Save
{
	CancelWait(Store3);
	CancelWait(Erase3);
}

PUSH Preset4_Save
{
	Wait(250, Store4) { Store(4); }
	Wait(1000, Erase4) { Erase(4); }
}
RELEASE Preset4_Save
{
	CancelWait(Store4);
	CancelWait(Erase4);
}

PUSH Preset5_Save
{
	Wait(250, Store5) { Store(5); }
	Wait(1000, Erase5) { Erase(5); }
}
RELEASE Preset5_Save
{
	CancelWait(Store5);
	CancelWait(Erase5);
}

PUSH Preset6_Save
{
	Wait(250, Store6) { Store(6); }
	Wait(1000, Erase6) { Erase(6); }
}
RELEASE Preset6_Save
{
	CancelWait(Store6);
	CancelWait(Erase6);
}

PUSH Preset1_Recall { Recall(1); }
PUSH Preset2_Recall { Recall(2); }
PUSH Preset3_Recall { Recall(3); }
PUSH Preset4_Recall { Recall(4); }
PUSH Preset5_Recall { Recall(5); }
PUSH Preset6_Recall { Recall(6); }

FUNCTION ArmSettle()
{
	Wait(100, Settle)
	{
		MatchPresets();
	}
}

FUNCTION RearmSettle()
{
	CancelWait(Settle);
	ArmSettle();
}

CHANGE Ain
{
	if (Driving = 0)
	{
		if (SyncLive() = 1)
		{
			ClearFeedback();
			RearmSettle();
		}
	}
}

FUNCTION Main()
{
	ClearFeedback();
	WaitForInitializationComplete();
	SyncLive();
	ArmSettle();
}
