#HELP_BEGIN
UDP Extract Data v2.0

Companion to UDP Broadcast and Receive v2.0. One instance latches IP, MAC, UID,
and Data from the last inbound packet that matches this instance's filter, and
drops that latch when the peer goes quiet.

Wire Received_IP / Received_MAC / Received_UID / Received_Data from the UDP
module. Wire Packet_Rx to Packet_Rx. Do not wire Enable_FB.

Packet_Rx evaluates the match immediately. The Received_* change path still
waits 0.01 s after the last change, so a v1.3 UDP symbol (no Packet_Rx) still
works.

Filter: Match_IP, Match_MAC, and Match_UID, each with a serial override.
Default for every match parameter is [SKIP] (that field is not used).
Any combination may be active. All active fields must match (AND).
Exact, case-sensitive compare.

At startup the locals take the parameters, then any override with length > 0.
CHANGE on an override sets that local to the override string as-is. An empty
string means [SKIP] from then on and does not fall back to the parameter.

A non-match does not clear a latch that is already held.
Timeout is unitTime. 0s keeps the last match and leaves Online_FB high.
Any other value drops Online_FB and clears the peer outputs when no new match
arrives within that time. Default 15s, maximum 600s.

Peer_UID is Received_UID from the matching packet.
Peer_Data is the raw Received_Data from the matching packet.

Drop one copy of this symbol per peer.

-- VERSION HISTORY --
v2.0  2026-10-18
- Packet_Rx evaluates the snapshot without the settle delay
- Online_FB and Timeout. 0s latches until a new match. Any other time clears
  the peer when packets stop.

v1.0  2026-09-09
- Prior symbol, left in the tree unchanged

#HELP_END

/* COMPILER DIRECTIVES */

#CATEGORY "46" "TCP/IP" // Custom
#DEFAULT_VOLATILE
#DEFINE_CONSTANT SKIP_TOKEN "[SKIP]"

/* INPUTS & OUTPUTS */

DIGITAL_INPUT	Packet_Rx;
STRING_INPUT	_SKIP_,
				Match_IP_Override[16], Match_MAC_Override[17], Match_UID_Override[32],
				_SKIP_,
				Received_IP[16], Received_MAC[17], Received_UID[32], Received_Data[255];

DIGITAL_OUTPUT	Online_FB;
STRING_OUTPUT	_SKIP_,
				_SKIP_, _SKIP_, _SKIP_,
				_SKIP_,
				Peer_IP, Peer_MAC, Peer_UID, Peer_Data;

INTEGER_PARAMETER	Timeout;
STRING_PARAMETER	_SKIP_, Match_IP[16], Match_MAC[17], Match_UID[32];

/* PROPERTIES */

#BEGIN_PARAMETER_PROPERTIES Timeout
	propValidUnits =		unitTime;
	propDefaultUnit =		unitTime;
	propBounds =			0s, 600s;
	propDefaultValue =		15s;
	propShortDescription =	"Drop the peer after this silence. 0s keeps the last match.";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Match_IP
	propValidUnits =		unitString;
	propDefaultUnit =		unitString;
	propDefaultValue =		"[SKIP]";
	propShortDescription =	"Match IP, or [SKIP]";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Match_MAC
	propValidUnits =		unitString;
	propDefaultUnit =		unitString;
	propDefaultValue =		"[SKIP]";
	propShortDescription =	"Match MAC, or [SKIP]";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Match_UID
	propValidUnits =		unitString;
	propDefaultUnit =		unitString;
	propDefaultValue =		"[SKIP]";
	propShortDescription =	"Match UID, or [SKIP]";
#END_PARAMETER_PROPERTIES

/* GLOBAL VARIABLES */

STRING	CurIP[16], CurMAC[17], CurUID[32];
INTEGER	Pending, PeerAge;

/* FUNCTIONS */

FUNCTION ArmSettle() {
	Pending = 1;
}

FUNCTION DropPeer() {
	Online_FB = 0;
	Peer_IP = "";
	Peer_MAC = "";
	Peer_UID = "";
	Peer_Data = "";
	PeerAge = 0;
}

FUNCTION EvaluateMatch() {
	INTEGER useIP, useMAC, useUID, ok;

	useIP = 0;
	useMAC = 0;
	useUID = 0;
	ok = 1;

	If ((LEN(CurIP) > 0) && (CurIP <> SKIP_TOKEN)) useIP = 1;
	If ((LEN(CurMAC) > 0) && (CurMAC <> SKIP_TOKEN)) useMAC = 1;
	If ((LEN(CurUID) > 0) && (CurUID <> SKIP_TOKEN)) useUID = 1;

	If ((useIP = 0) && (useMAC = 0) && (useUID = 0)) Return;

	If (useIP = 1) {
		If (Received_IP <> CurIP) ok = 0;
	}
	If (useMAC = 1) {
		If (Received_MAC <> CurMAC) ok = 0;
	}
	If (useUID = 1) {
		If (Received_UID <> CurUID) ok = 0;
	}

	If (ok = 1) {
		Peer_IP = Received_IP;
		Peer_MAC = Received_MAC;
		Peer_UID = Received_UID;
		Peer_Data = Received_Data;
		PeerAge = 0;
		Online_FB = 1;
	}
}

FUNCTION AgePeer() {
	If (Timeout = 0) Return;
	If (Online_FB = 0) Return;
	PeerAge = PeerAge + 1;
	If (PeerAge >= Timeout) DropPeer();
}

/* EVENT HANDLERS */

CHANGE Match_IP_Override {
	CurIP = Match_IP_Override;
	ArmSettle();
}

CHANGE Match_MAC_Override {
	CurMAC = Match_MAC_Override;
	ArmSettle();
}

CHANGE Match_UID_Override {
	CurUID = Match_UID_Override;
	ArmSettle();
}

CHANGE Received_IP {
	ArmSettle();
}

CHANGE Received_MAC {
	ArmSettle();
}

CHANGE Received_UID {
	ArmSettle();
}

CHANGE Received_Data {
	ArmSettle();
}

PUSH Packet_Rx {
	Pending = 0;
	EvaluateMatch();
}

/* MAIN */

FUNCTION Main() {
	WaitForInitializationComplete();
	CurIP = Match_IP;
	CurMAC = Match_MAC;
	CurUID = Match_UID;
	If (LEN(Match_IP_Override) > 0) CurIP = Match_IP_Override;
	If (LEN(Match_MAC_Override) > 0) CurMAC = Match_MAC_Override;
	If (LEN(Match_UID_Override) > 0) CurUID = Match_UID_Override;
	Pending = 0;
	PeerAge = 0;
	Online_FB = 0;
	WHILE (1) {
		If (Pending = 1) {
			Pending = 0;
			DELAY(1);
			If (Pending = 0) EvaluateMatch();
		}
		Else {
			DELAY(1);
		}
		AgePeer();
	}
}
