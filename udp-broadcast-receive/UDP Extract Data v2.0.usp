#HELP_BEGIN
UDP Extract Data v2.0

One instance per peer. Wire Packet_Rx and the four Received_* inputs
from UDP Broadcast and Receive v2.0. Do not wire Enable_FB.

Match parameters default to [SKIP]. An empty override stays [SKIP]
and does not fall back to the parameter. Every active field must match.
A non-match does not clear a peer that is already held.

Timeout 0s leaves Online_FB high. Any other time clears the peer when
matching packets stop. A repeat match restarts that time.

Peer outputs and Online_FB are written only when the value changes.
String outputs are write-only.

Press F1 for UDP Beacon and Extract v2.0.html. Leave that file next
to this module.

-- VERSION HISTORY --
v2.0  2026-10-18
- 2026-11-03: F1 opens UDP Beacon and Extract v2.0.html, shared with the beacon
- 2026-11-02: Peer_* and Online_FB update only when the value changes
- Packet_Rx evaluates the snapshot without the settle delay
- Online_FB and Timeout. 0s latches until a new match. Any other time clears
  the peer when packets stop.

v1.0  2026-09-09
- Prior symbol, left in the tree unchanged

#HELP_END

/* COMPILER DIRECTIVES */

#HELP_PDF_FILE "UDP Beacon and Extract v2.0.html"
#CATEGORY "46" "TCP/IP" // Custom
#DEFAULT_VOLATILE
#DEFINE_CONSTANT SKIP_TOKEN "[SKIP]"

/* INPUTS & OUTPUTS */

DIGITAL_INPUT	Packet_Rx;
STRING_INPUT	_SKIP_,
				Match_IP_Override[16], Match_MAC_Override[17], Match_UID_Override[32],
				_SKIP_,
				Received_IP[16], Received_MAC[17], Received_UID[32], Received_Data[255];

DIGITAL_OUTPUT	Online_FB;
STRING_OUTPUT	_SKIP_,
				_SKIP_, _SKIP_, _SKIP_,
				_SKIP_,
				Peer_IP, Peer_MAC, Peer_UID, Peer_Data;

INTEGER_PARAMETER	Timeout;
STRING_PARAMETER	_SKIP_, Match_IP[16], Match_MAC[17], Match_UID[32];

/* PROPERTIES */

#BEGIN_PARAMETER_PROPERTIES Timeout
	propValidUnits =		unitTime;
	propDefaultUnit =		unitTime;
	propBounds =			0s, 600s;
	propDefaultValue =		15s;
	propShortDescription =	"Drop the peer after this silence. 0s keeps the last match.";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Match_IP
	propValidUnits =		unitString;
	propDefaultUnit =		unitString;
	propDefaultValue =		"[SKIP]";
	propShortDescription =	"Match IP, or [SKIP]";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Match_MAC
	propValidUnits =		unitString;
	propDefaultUnit =		unitString;
	propDefaultValue =		"[SKIP]";
	propShortDescription =	"Match MAC, or [SKIP]";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Match_UID
	propValidUnits =		unitString;
	propDefaultUnit =		unitString;
	propDefaultValue =		"[SKIP]";
	propShortDescription =	"Match UID, or [SKIP]";
#END_PARAMETER_PROPERTIES

/* GLOBAL VARIABLES */

STRING	CurIP[16], CurMAC[17], CurUID[32],
		LastPeerIP[16], LastPeerMAC[17], LastPeerUID[32], LastPeerData[255];
INTEGER	Pending, PeerAge;

/* FUNCTIONS */

FUNCTION ArmSettle() {
	Pending = 1;
}

FUNCTION DropPeer() {
	If (Online_FB <> 0) Online_FB = 0;
	If (LEN(LastPeerIP) > 0) {
		LastPeerIP = "";
		Peer_IP = "";
	}
	If (LEN(LastPeerMAC) > 0) {
		LastPeerMAC = "";
		Peer_MAC = "";
	}
	If (LEN(LastPeerUID) > 0) {
		LastPeerUID = "";
		Peer_UID = "";
	}
	If (LEN(LastPeerData) > 0) {
		LastPeerData = "";
		Peer_Data = "";
	}
	PeerAge = 0;
}

FUNCTION EvaluateMatch() {
	INTEGER useIP, useMAC, useUID, ok;

	useIP = 0;
	useMAC = 0;
	useUID = 0;
	ok = 1;

	If ((LEN(CurIP) > 0) && (CurIP <> SKIP_TOKEN)) useIP = 1;
	If ((LEN(CurMAC) > 0) && (CurMAC <> SKIP_TOKEN)) useMAC = 1;
	If ((LEN(CurUID) > 0) && (CurUID <> SKIP_TOKEN)) useUID = 1;

	If ((useIP = 0) && (useMAC = 0) && (useUID = 0)) Return;

	If (useIP = 1) {
		If (Received_IP <> CurIP) ok = 0;
	}
	If (useMAC = 1) {
		If (Received_MAC <> CurMAC) ok = 0;
	}
	If (useUID = 1) {
		If (Received_UID <> CurUID) ok = 0;
	}

	If (ok = 1) {
		/* Peer_* are write-only. LastPeer* is the last text written. */
		If (CompareStrings(LastPeerIP, Received_IP) <> 0) {
			LastPeerIP = Received_IP;
			Peer_IP = Received_IP;
		}
		If (CompareStrings(LastPeerMAC, Received_MAC) <> 0) {
			LastPeerMAC = Received_MAC;
			Peer_MAC = Received_MAC;
		}
		If (CompareStrings(LastPeerUID, Received_UID) <> 0) {
			LastPeerUID = Received_UID;
			Peer_UID = Received_UID;
		}
		If (CompareStrings(LastPeerData, Received_Data) <> 0) {
			LastPeerData = Received_Data;
			Peer_Data = Received_Data;
		}
		PeerAge = 0;
		If (Online_FB <> 1) Online_FB = 1;
	}
}

FUNCTION AgePeer() {
	If (Timeout = 0) Return;
	If (Online_FB = 0) Return;
	PeerAge = PeerAge + 1;
	If (PeerAge >= Timeout) DropPeer();
}

/* EVENT HANDLERS */

CHANGE Match_IP_Override {
	CurIP = Match_IP_Override;
	ArmSettle();
}

CHANGE Match_MAC_Override {
	CurMAC = Match_MAC_Override;
	ArmSettle();
}

CHANGE Match_UID_Override {
	CurUID = Match_UID_Override;
	ArmSettle();
}

CHANGE Received_IP {
	ArmSettle();
}

CHANGE Received_MAC {
	ArmSettle();
}

CHANGE Received_UID {
	ArmSettle();
}

CHANGE Received_Data {
	ArmSettle();
}

PUSH Packet_Rx {
	Pending = 0;
	EvaluateMatch();
}

/* MAIN */

FUNCTION Main() {
	WaitForInitializationComplete();
	CurIP = Match_IP;
	CurMAC = Match_MAC;
	CurUID = Match_UID;
	If (LEN(Match_IP_Override) > 0) CurIP = Match_IP_Override;
	If (LEN(Match_MAC_Override) > 0) CurMAC = Match_MAC_Override;
	If (LEN(Match_UID_Override) > 0) CurUID = Match_UID_Override;
	Pending = 0;
	PeerAge = 0;
	If (Online_FB <> 0) Online_FB = 0;
	WHILE (1) {
		If (Pending = 1) {
			Pending = 0;
			DELAY(1);
			If (Pending = 0) EvaluateMatch();
		}
		Else {
			DELAY(1);
		}
		AgePeer();
	}
}
