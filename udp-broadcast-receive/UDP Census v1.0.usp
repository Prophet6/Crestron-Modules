#HELP_BEGIN
UDP Census v1.0

4-Series. UdpCensus_v1.clz must sit in this folder. SPlusCC does not
rebuild that library.

This socket defaults to UDP 50002.

SIMPL+ names are case-insensitive. A local with the same name as an input
is that input. String outputs are write-only. Keep a copy, compare it,
and assign the output only when the text changes. Digitals and Count can
be read.

Show_Index 0 is row 1 until the analog moves. After that, 0 blanks the
four Processor outputs and drops Answered_FB. Count does not change.

Notices, and only these, go to the error log:
  UdpCensus: answered <ip>:<port>
  UdpCensus: added <uid> <ip>
  UdpCensus: removed <uid> <ip>
GenerateUserNotice needs a format string: GenerateUserNotice("%s", NoticeBuf).

A non-zero Poll_Interval below 1s is raised to 1s. Poll_Window 0 becomes 3s.
The window is clamped to 0.5s-30s. A port outside 1024-65535 becomes 50002.

Press F1 for UDP Census v1.0.html. Leave that file next to this module.

-- VERSION HISTORY --
v1.0  2026-10-20
- 2026-11-03: UDP_Port default is 50002. An out-of-range port becomes 50002
- 2026-11-03: F1 opens UDP Census v1.0.html
- 2026-11-03: Show_Index shares the Count row. A blank row sits above Processor_IP
- Poll, answer, or both, in one symbol
- Indexed database of the processors that answered
- 2026-11-02 Symbol rows: blank around Enable, Discover above Respond, poll times together
- Count and the database strings were ignored because the callback names matched the signals
- A discover poll is sent on the Poll path as soon as the socket is open
- The row selector is Show_Index. 1 displays the first row
- Answering a poll posts a user notice. A row is noted only when it is added or removed
- An output is written only when its value changes

#HELP_END

/* COMPILER DIRECTIVES */

#HELP_PDF_FILE "UDP Census v1.0.html"
#CATEGORY "46" "TCP/IP" // Custom
#DEFAULT_VOLATILE
#USER_SIMPLSHARP_LIBRARY "UdpCensus_v1"

/* INPUTS & OUTPUTS */

DIGITAL_INPUT	_SKIP_, Enable, _SKIP_, Poll,
				_SKIP_,
				_SKIP_,
				Discover, Respond,
				_SKIP_;
ANALOG_INPUT	_SKIP_, Show_Index;
STRING_INPUT	_SKIP_, _SKIP_, Mac[17], UID[32], Data[128];

DIGITAL_OUTPUT	_SKIP_, Enable_FB, _SKIP_, Polling_FB,
				_SKIP_,
				_SKIP_, _SKIP_,
				_SKIP_, _SKIP_,
				Answered_FB;
ANALOG_OUTPUT	Count;
STRING_OUTPUT	_SKIP_, Processor_IP, Processor_MAC, Processor_UID, Processor_Data;

INTEGER_PARAMETER	UDP_Port, _SKIP_, _SKIP_, Poll_Window, Poll_Interval,
					_SKIP_, Discover_Mode, Respond_Mode;

/* PROPERTIES */

#BEGIN_PARAMETER_PROPERTIES UDP_Port
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propBounds =			1024d, 65535d;
	propDefaultValue =		50002d;
	propShortDescription =	"UDP port";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Poll_Window
	propValidUnits =		unitTime;
	propDefaultUnit =		unitTime;
	propBounds =			0.5s, 30s;
	propDefaultValue =		3s;
	propShortDescription =	"How long to accept answers after a poll";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Respond_Mode
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propDefaultValue =		1d;
	propList =				{0d, "Off"},
							{1d, "Answer polls"};
	propShortDescription =	"Answer ?POLL when the Respond digital is unwired";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Discover_Mode
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propDefaultValue =		0d;
	propList =				{0d, "Off"},
							{1d, "Keep the database"};
	propShortDescription =	"Poll on Poll_Interval when the Discover digital is unwired";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Poll_Interval
	propValidUnits =		unitTime;
	propDefaultUnit =		unitTime;
	propBounds =			0s, 600s;
	propDefaultValue =		30s;
	propShortDescription =	"Time between polls. 0s polls only on the Poll pulse.";
#END_PARAMETER_PROPERTIES

/* GLOBAL VARIABLES */

INTEGER		RespondHeld, DiscoverHeld;
STRING		IpBuf[64], MacBuf[17], UidBuf[32], DataBuf[128], NoticeBuf[160];
STRING		LastIp[64], LastMac[17], LastUid[32], LastData[128];
UdpCensus	Core;

/* FUNCTIONS */

FUNCTION PushSetup() {
	/* SIMPL+ names are case-insensitive. These must not match the Discover or Respond inputs. */
	INTEGER respondMode, discoverMode;

	respondMode = Respond_Mode;
	discoverMode = Discover_Mode;
	If (RespondHeld = 1) respondMode = Respond;
	If (DiscoverHeld = 1) discoverMode = Discover;
	Core.Configure(respondMode, discoverMode, UDP_Port, Poll_Interval, Poll_Window);
	Core.SetIdentity(Mac, UID, Data);
}

/* CALLBACKS */

CALLBACK FUNCTION HandleCensus (Integer socketOpen, Integer windowOpen, Integer rowCount) {
	If (Enable_FB <> socketOpen) Enable_FB = socketOpen;
	If (Polling_FB <> windowOpen) Polling_FB = windowOpen;
	If (Count <> rowCount) Count = rowCount;
}

CALLBACK FUNCTION HandleNotice (String noticeText) {
	NoticeBuf = noticeText;
	GenerateUserNotice("%s", NoticeBuf);
}

CALLBACK FUNCTION HandleRecord (String rowIp, String rowMac, String rowUid, String rowData, Integer rowAnswered) {
	IpBuf = rowIp;
	MacBuf = rowMac;
	UidBuf = rowUid;
	DataBuf = rowData;
	If (CompareStrings(LastIp, IpBuf) <> 0)
	{
		LastIp = IpBuf;
		Processor_IP = IpBuf;
	}
	If (CompareStrings(LastMac, MacBuf) <> 0)
	{
		LastMac = MacBuf;
		Processor_MAC = MacBuf;
	}
	If (CompareStrings(LastUid, UidBuf) <> 0)
	{
		LastUid = UidBuf;
		Processor_UID = UidBuf;
	}
	If (CompareStrings(LastData, DataBuf) <> 0)
	{
		LastData = DataBuf;
		Processor_Data = DataBuf;
	}
	If (Answered_FB <> rowAnswered) Answered_FB = rowAnswered;
}

/* EVENT HANDLERS */

CHANGE Enable {
	If (Enable = 1) Core.Open();
	Else Core.Close();
}

PUSH Poll {
	Core.PollNow();
}

CHANGE Respond {
	RespondHeld = 1;
	PushSetup();
}

CHANGE Discover {
	DiscoverHeld = 1;
	PushSetup();
}

CHANGE Mac {
	Core.SetIdentity(Mac, UID, Data);
}

CHANGE UID {
	Core.SetIdentity(Mac, UID, Data);
}

CHANGE Data {
	Core.SetIdentity(Mac, UID, Data);
}

CHANGE Show_Index {
	Core.Select(Show_Index);
}

/* MAIN */

FUNCTION Main() {
	RegisterDelegate(Core, OnCensus, HandleCensus);
	RegisterDelegate(Core, OnRecord, HandleRecord);
	RegisterDelegate(Core, OnNotice, HandleNotice);
	WaitForInitializationComplete();
	If (Respond = 1) RespondHeld = 1;
	If (Discover = 1) DiscoverHeld = 1;
	PushSetup();
	If (Show_Index > 0) Core.Select(Show_Index);
	Else Core.Select(1);
	If (Enable = 1) Core.Open();
}
