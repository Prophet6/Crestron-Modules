#HELP_BEGIN
UDP Broadcast and Receive v2.0

4-Series. This socket defaults to UDP 50001.

A CR or LF ends one received datagram. Two processor announces have
neither, so two of those can still arrive as one buffer.

Received strings and Enable_FB are written only when the value changes.
Packet_Rx still pulses for every accepted packet.

Reply uses the one SIMPL+ UDP socket. It is aimed at the sender, then
put back on 255.255.255.255. A datagram in that gap can be missed.

A stored MAC whose length is not 12 or 17 is published as
00:00:00:00:00:00. Own packets are dropped and are not answered.

Press F1 for UDP Beacon and Extract v2.0.html. That file is also the
help for UDP Extract Data v2.0. Leave it next to both modules.

-- VERSION HISTORY --
v2.0  2026-10-19
- 2026-11-03: F1 opens UDP Beacon and Extract v2.0.html, shared with Extract
- 2026-11-02: CR or LF ends one received datagram, so a second copy
  concatenated in SocketRxBuf is not stored in Received_Data
- 2026-11-02: Received_* and Enable_FB update only when the value changes
- Announce_Interval heartbeat (0s off, default 5s). Use 15s or 30s when
  hundreds of processors share the port
- Reply off by default. On answers each new sender once, then waits through
  60s of silence, and sends at most one reply every 0.5 s
- Packet_Rx pulses after the four received strings are written
- Re-open the socket if Enable is high and the listen socket drops

v1.3  2026-09-09
- Prior symbol, left in the tree unchanged

#HELP_END

/* COMPILER DIRECTIVES */

#HELP_PDF_FILE "UDP Beacon and Extract v2.0.html"
#CATEGORY "46" "TCP/IP" // Custom
#DEFAULT_VOLATILE
#DEFINE_CONSTANT BROADCAST_IP "255.255.255.255"
#DEFINE_CONSTANT HOLD_SLOTS 128
#DEFINE_CONSTANT QUEUE_SLOTS 8
#DEFINE_CONSTANT REPLY_GAP 50
#DEFINE_CONSTANT REPLY_MEMORY 6000
//#ENABLE_TRACE

/* INPUTS & OUTPUTS */

DIGITAL_INPUT	_SKIP_, _SKIP_, _SKIP_, _SKIP_, Enable, Retrigger, _SKIP_, _SKIP_;
STRING_INPUT	_SKIP_, Mac[17], UID[32], Data[255];

DIGITAL_OUTPUT	_SKIP_, _SKIP_, _SKIP_, _SKIP_, Enable_FB, _SKIP_, _SKIP_, Packet_Rx;
STRING_OUTPUT	Received_IP, Received_MAC, Received_UID, Received_Data;

INTEGER_PARAMETER	UDP_Port, Enforce_Format, Announce_Interval, Reply;

/* PROPERTIES */

#BEGIN_PARAMETER_PROPERTIES UDP_Port
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propBounds =			1024d, 65535d;
	propDefaultValue =		50001d;
	propShortDescription =	"UDP port";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Enforce_Format
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propDefaultValue =		0d;
	propList =				{0d, "No enforcement"},
							{1d, "Enforce MAC,UID,Data"};
	propShortDescription =	"Require incoming packets to be MAC,UID,Data";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Announce_Interval
	propValidUnits =		unitTime;
	propDefaultUnit =		unitTime;
	propBounds =			0s, 600s;
	propDefaultValue =		5s;
	propShortDescription =	"Announce period. 0s sends only on Retrigger or Data.";
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Reply
	propValidUnits =		unitDecimal;
	propDefaultUnit =		unitDecimal;
	propDefaultValue =		0d;
	propList =				{0d, "Off"},
							{1d, "Once per new sender"};
	propShortDescription =	"Off when many processors announce. On answers a new sender once.";
#END_PARAMETER_PROPERTIES

/* GLOBAL VARIABLES */

UDP_SOCKET	UDPSocket[306];
INTEGER		SocketOpen, SocketBusy, NeedPulse, ReplyCount, AnnounceLeft, ReopenLeft,
			ReplyWait, HavePacket, GotMAC, GotUID, AccRaw, HoldAge[128];
/* ReplyQ and HoldIP: first bracket is the count, second is the length. */
STRING		RxBuf[306], TxPacket[306], AccMAC[17], AccUID[32], AccData[306],
			LastIP[15], LastMAC[17], LastUID[32], LastData[306],
			ReplyQ[8][16], HoldIP[128][16];

/* FUNCTIONS */

INTEGER_FUNCTION IsHexChar(INTEGER c) {
	If ((c >= 48) && (c <= 57)) Return (1);	/* 0-9 */
	If ((c >= 65) && (c <= 70)) Return (1);	/* A-F */
	If ((c >= 97) && (c <= 102)) Return (1);	/* a-f */
	Return (0);
}

INTEGER_FUNCTION IsUidChar(INTEGER c) {
	If ((c >= 48) && (c <= 57)) Return (1);	/* 0-9 */
	If ((c >= 65) && (c <= 90)) Return (1);	/* A-Z */
	If ((c >= 97) && (c <= 122)) Return (1);	/* a-z */
	If (c = 45) Return (1);	/* hyphen */
	If (c = 95) Return (1);	/* underscore */
	Return (0);
}

INTEGER_FUNCTION LooksLikeMAC(STRING srcStr) {
	INTEGER i, sep, ch, n;

	n = LEN(srcStr);
	If (n = 12) {
		For (i = 1 to 12) {
			ch = BYTE(srcStr, i);
			If (IsHexChar(ch) = 0) Return (0);
		}
		Return (1);
	}

	If (n = 17) {
		sep = BYTE(srcStr, 3);
		If ((sep <> 58) && (sep <> 45)) Return (0);	/* : or - */
		ch = BYTE(srcStr, 6);
		If (ch <> sep) Return (0);
		ch = BYTE(srcStr, 9);
		If (ch <> sep) Return (0);
		ch = BYTE(srcStr, 12);
		If (ch <> sep) Return (0);
		ch = BYTE(srcStr, 15);
		If (ch <> sep) Return (0);
		For (i = 1 to 17) {
			If ((i <> 3) && (i <> 6) && (i <> 9) && (i <> 12) && (i <> 15)) {
				ch = BYTE(srcStr, i);
				If (IsHexChar(ch) = 0) Return (0);
			}
		}
		Return (1);
	}

	Return (0);
}

INTEGER_FUNCTION LooksLikeUID(STRING srcStr) {
	INTEGER i, ch, n;

	n = LEN(srcStr);
	If ((n = 0) || (n > 32)) Return (0);
	For (i = 1 to n) {
		ch = BYTE(srcStr, i);
		If (IsUidChar(ch) = 0) Return (0);
	}
	Return (1);
}

STRING_FUNCTION FormatMAC(STRING tempMAC) {
	STRING temp[17];

	If (LEN(tempMAC) = 17) {
		If (FIND(":", tempMAC))
			Return (tempMAC);
		Else {
			MakeString(temp, "%s:%s:%s:%s:%s:%s", Mid(tempMAC, 1, 2), Mid(tempMAC, 4, 2), Mid(tempMAC, 7, 2), Mid(tempMAC, 10, 2), Mid(tempMAC, 13, 2), Mid(tempMAC, 16, 2));
			Return (temp);
		}
	}

	Else If (LEN(tempMAC) = 12) {
		MakeString(temp, "%s:%s:%s:%s:%s:%s", Mid(tempMAC, 1, 2), Mid(tempMAC, 3, 2), Mid(tempMAC, 5, 2), Mid(tempMAC, 7, 2), Mid(tempMAC, 9, 2), Mid(tempMAC, 11, 2));
		Return (temp);
	}

	Else {
		TRACE("[UDP]: MAC address error, incorrect length (%u) for \x22%s\x22", LEN(tempMAC), tempMAC);
		Return ("00:00:00:00:00:00");
	}
}

INTEGER_FUNCTION PacketIsSelf(STRING srcMAC, STRING srcUID) {
	STRING mine[306], localMAC[17], packetMAC[17];
	INTEGER isMac;

	localMAC = FormatMAC(Mac);
	MakeString(mine, "%s,%s,%s", localMAC, UID, Data);
	If (RxBuf = mine) Return (1);

	If ((LEN(Mac) = 0) && (LEN(UID) = 0)) Return (0);

	isMac = LooksLikeMAC(srcMAC);
	packetMAC = FormatMAC(srcMAC);
	If ((isMac = 1) && (packetMAC = localMAC) && (srcUID = UID))
		Return (1);

	Return (0);
}

FUNCTION BuildPacket() {
	MakeString(TxPacket, "%s,%s,%s", FormatMAC(Mac), UID, Data);
}

FUNCTION SetEnableFB(INTEGER fbLevel) {
	If (Enable_FB <> fbLevel) Enable_FB = fbLevel;
}

FUNCTION OpenSocket() {
	SIGNED_INTEGER status;

	If (SocketBusy = 1) Return;

	If (SocketOpen = 1) {
		SocketUDP_Disable(UDPSocket);
		SocketOpen = 0;
		SetEnableFB(0);
	}

	status = SocketUDP_Enable(UDPSocket, BROADCAST_IP, UDP_Port);
	If (status < 0) {
		SocketOpen = 0;
		SetEnableFB(0);
		TRACE("[UDP]: Failed to open UDP socket (error %d)", status);
	}
	Else {
		SocketOpen = 1;
		SetEnableFB(1);
		AnnounceLeft = 0;
		TRACE("[UDP]: Opened UDP Socket successfully");
	}
}

FUNCTION CloseSocket() {
	SIGNED_INTEGER status;

	If (SocketBusy = 1) Return;

	If (SocketOpen = 1) {
		status = SocketUDP_Disable(UDPSocket);
		If (status < 0) TRACE("[UDP]: Failed to close UDP socket (error %d)", status);
		Else TRACE("[UDP]: Closed UDP Socket");
	}
	SocketOpen = 0;
	SetEnableFB(0);
}

INTEGER_FUNCTION SendBroadcast(INTEGER allowEmptyData) {
	SIGNED_INTEGER status;

	If (SocketOpen = 0) {
		TRACE("[UDP]: Send ignored, socket is not open");
		Return (0);
	}
	If (SocketBusy = 1) Return (0);

	If ((allowEmptyData = 0) && (LEN(Data) = 0)) Return (0);

	BuildPacket();
	status = SocketSend(UDPSocket, TxPacket);
	If (status < 0) {
		TRACE("[UDP]: SocketSend failed (error %d)", status);
		Return (0);
	}
	TRACE("[UDP]: Sent: %s", TxPacket);
	Return (1);
}

INTEGER_FUNCTION FindHold(STRING ip) {
	INTEGER i;

	For (i = 1 to HOLD_SLOTS) {
		If ((LEN(HoldIP[i]) > 0) && (HoldIP[i] = ip)) Return (i);
	}
	Return (0);
}

INTEGER_FUNCTION FreeHold() {
	INTEGER i;

	For (i = 1 to HOLD_SLOTS) {
		If (LEN(HoldIP[i]) = 0) Return (i);
	}
	Return (0);
}

FUNCTION RememberHold(STRING ip) {
	INTEGER slot;

	slot = FindHold(ip);
	If (slot > 0) HoldAge[slot] = 0;
}

FUNCTION AgeHolds(INTEGER elapsed) {
	INTEGER i;

	For (i = 1 to HOLD_SLOTS) {
		If (LEN(HoldIP[i]) > 0) {
			HoldAge[i] = HoldAge[i] + elapsed;
			If (HoldAge[i] >= REPLY_MEMORY) {
				HoldIP[i] = "";
				HoldAge[i] = 0;
			}
		}
	}
}

FUNCTION QueueReply(STRING ip) {
	INTEGER slot;

	If (Reply <> 1) Return;
	If (LEN(ip) = 0) Return;
	If (ip = BROADCAST_IP) Return;
	If (ip = "0.0.0.0") Return;

	slot = FindHold(ip);
	If (slot > 0) {
		HoldAge[slot] = 0;
		Return;
	}
	If (ReplyCount >= QUEUE_SLOTS) Return;

	slot = FreeHold();
	If (slot = 0) {
		TRACE("[UDP]: Reply table full, no unicast for %s", ip);
		Return;
	}
	HoldIP[slot] = ip;
	HoldAge[slot] = 0;
	ReplyCount = ReplyCount + 1;
	ReplyQ[ReplyCount] = ip;
}

FUNCTION SendUnicast(STRING destIP) {
	SIGNED_INTEGER status;

	If (SocketOpen = 0) Return;
	If (SocketBusy = 1) Return;
	If (LEN(destIP) = 0) Return;

	SocketBusy = 1;
	BuildPacket();

	status = SocketUDP_Disable(UDPSocket);
	If (status < 0) TRACE("[UDP]: Reply disable failed (error %d)", status);

	status = SocketUDP_Enable(UDPSocket, destIP, UDP_Port);
	If (status < 0) {
		TRACE("[UDP]: Reply open failed for %s (error %d)", destIP, status);
	}
	Else {
		status = SocketSend(UDPSocket, TxPacket);
		If (status < 0) TRACE("[UDP]: Reply send failed to %s (error %d)", destIP, status);
		Else {
			TRACE("[UDP]: Replied to %s: %s", destIP, TxPacket);
			RememberHold(destIP);
		}
		SocketUDP_Disable(UDPSocket);
	}

	status = SocketUDP_Enable(UDPSocket, BROADCAST_IP, UDP_Port);
	If (status < 0) {
		SocketOpen = 0;
		SetEnableFB(0);
		TRACE("[UDP]: Failed to restore broadcast socket (error %d)", status);
	}
	Else {
		SocketOpen = 1;
		SetEnableFB(1);
	}
	SocketBusy = 0;
}

FUNCTION DrainOneReply() {
	INTEGER i;
	STRING dest[16];

	If (ReplyCount = 0) Return;
	If (ReplyWait > 0) Return;
	If ((SocketOpen = 0) || (SocketBusy = 1)) Return;

	dest = ReplyQ[1];
	For (i = 1 to ReplyCount - 1) ReplyQ[i] = ReplyQ[i + 1];
	ReplyQ[ReplyCount] = "";
	ReplyCount = ReplyCount - 1;
	SendUnicast(dest);
	ReplyWait = REPLY_GAP;
}

/*
 * One datagram. A self or rejected chunk returns without touching the
 * outputs, so a later chunk in the same buffer can still be stored.
 * The last accepted chunk wins. PublishPacket writes it once.
 */
FUNCTION StorePacket(STRING piece) {
	INTEGER pos1, pos2, macOk, uidOk, packetOk;
	STRING field1[306], field2[306], field3[306], srcMAC[17], srcUID[32], srcData[306];

	If (LEN(piece) = 0) Return;

	RxBuf = piece;
	macOk = 0;
	uidOk = 0;
	packetOk = 0;
	srcMAC = "";
	srcUID = "";
	srcData = "";

	pos1 = FIND(",", piece);
	pos2 = 0;
	If (pos1 > 0) pos2 = FIND(",", piece, pos1 + 1);

	If ((pos1 > 0) && (pos2 > 0)) {
		field1 = LEFT(piece, pos1 - 1);
		field2 = MID(piece, pos1 + 1, pos2 - (pos1 + 1));
		field3 = MID(piece, pos2 + 1, LEN(piece));

		If (LooksLikeMAC(field1) = 1) {
			macOk = 1;
			srcMAC = field1;
			If (LooksLikeUID(field2) = 1) {
				uidOk = 1;
				srcUID = field2;
				srcData = field3;
				packetOk = 1;
			}
			Else {
				srcData = MID(piece, pos1 + 1, LEN(piece));
			}
		}
		Else {
			srcData = piece;
		}
	}
	Else If (pos1 > 0) {
		field1 = LEFT(piece, pos1 - 1);
		field2 = MID(piece, pos1 + 1, LEN(piece));

		If (LooksLikeMAC(field1) = 1) {
			macOk = 1;
			srcMAC = field1;
			If (LooksLikeUID(field2) = 1) {
				uidOk = 1;
				srcUID = field2;
			}
			Else {
				srcData = field2;
			}
		}
		Else {
			srcData = piece;
		}
	}
	Else {
		If (LooksLikeMAC(piece) = 1) {
			macOk = 1;
			srcMAC = piece;
		}
		Else If (LooksLikeUID(piece) = 1) {
			uidOk = 1;
			srcUID = piece;
		}
		Else {
			srcData = piece;
		}
	}

	If (PacketIsSelf(srcMAC, srcUID) = 1) {
		TRACE("[UDP]: Ignored own packet");
		Return;
	}

	If ((Enforce_Format = 1) && (packetOk = 0)) {
		TRACE("[UDP]: Dropped non-conforming packet (Enforce MAC,UID,Data)");
		Return;
	}

	HavePacket = 1;
	GotMAC = macOk;
	GotUID = uidOk;
	AccRaw = 0;
	AccMAC = srcMAC;
	AccUID = srcUID;
	AccData = srcData;
	If ((LEN(srcData) = 0) && (macOk = 0) && (uidOk = 0) && (LEN(piece) > 0)) {
		AccData = piece;
		AccRaw = 1;
	}
}

FUNCTION PublishPacket(STRING senderIP) {
	STRING nextIP[15], nextMAC[17], nextUID[32], nextData[306];

	If (HavePacket = 0) Return;

	nextIP = "";
	nextMAC = "";
	nextUID = "";
	nextData = "";

	If (LEN(senderIP) > 0) nextIP = senderIP;

	If (GotMAC = 1) {
		nextMAC = FormatMAC(AccMAC);
		TRACE("[UDP]: Parsed Mac: %s", nextMAC);
	}
	If (GotUID = 1) {
		nextUID = AccUID;
		TRACE("[UDP]: Parsed UID: %s", AccUID);
	}
	If (LEN(AccData) > 0) {
		nextData = AccData;
		If (AccRaw = 1) TRACE("[UDP]: Unstructured payload as Data: %s", AccData);
		Else TRACE("[UDP]: Parsed Data: %s", AccData);
	}

	/* String outputs cannot be read. Last* is the last text written. */
	If (CompareStrings(LastIP, nextIP) <> 0) {
		LastIP = nextIP;
		Received_IP = nextIP;
	}
	If (CompareStrings(LastMAC, nextMAC) <> 0) {
		LastMAC = nextMAC;
		Received_MAC = nextMAC;
	}
	If (CompareStrings(LastUID, nextUID) <> 0) {
		LastUID = nextUID;
		Received_UID = nextUID;
	}
	If (CompareStrings(LastData, nextData) <> 0) {
		LastData = nextData;
		Received_Data = nextData;
	}

	QueueReply(senderIP);
	NeedPulse = 1;
}

/* EVENT HANDLERS */

CHANGE Enable {
	If (Enable = 1) OpenSocket();
	Else CloseSocket();
}

PUSH Retrigger {
	SendBroadcast(1);
}

CHANGE Data {
	SendBroadcast(0);
}

SOCKETRECEIVE UDPSocket {
	SIGNED_INTEGER status;
	INTEGER i, n, start, ch;
	STRING raw[306], senderIP[15], piece[306];

	raw = UDPSocket.SocketRxBuf;
	ClearBuffer(UDPSocket.SocketRxBuf);

	TRACE("[UDP]: Socket received raw: %s", raw);

	HavePacket = 0;
	GotMAC = 0;
	GotUID = 0;
	AccRaw = 0;
	AccMAC = "";
	AccUID = "";
	AccData = "";
	senderIP = "";

	status = SocketGetSenderIPAddress(UDPSocket, senderIP);
	If (status <> 0) {
		senderIP = "";
		TRACE("[UDP]: Failed to retrieve sender's IP (error: %d)", status);
	}

	/* SIMPL+ concatenates datagrams that arrive before this event. CR or LF splits them. */
	n = LEN(raw);
	start = 1;
	i = 1;
	WHILE (i <= n) {
		ch = BYTE(raw, i);
		If ((ch = 13) || (ch = 10)) {
			If (i > start) {
				piece = MID(raw, start, i - start);
				StorePacket(piece);
			}
			start = i + 1;
		}
		i = i + 1;
	}
	If (start <= n) {
		piece = MID(raw, start, n - start + 1);
		StorePacket(piece);
	}

	PublishPacket(senderIP);
}

/* MAIN */

FUNCTION Main() {
	INTEGER i;

	SocketOpen = 0;
	SocketBusy = 0;
	NeedPulse = 0;
	ReplyCount = 0;
	AnnounceLeft = 0;
	ReopenLeft = 0;
	ReplyWait = 0;
	SetEnableFB(0);
	For (i = 1 to QUEUE_SLOTS) ReplyQ[i] = "";
	For (i = 1 to HOLD_SLOTS) {
		HoldIP[i] = "";
		HoldAge[i] = 0;
	}
	WaitForInitializationComplete();
	If (Enable = 1) OpenSocket();

	WHILE (1) {
		DrainOneReply();
		If (NeedPulse = 1) {
			NeedPulse = 0;
			Pulse(5, Packet_Rx);
		}
		If ((Enable = 1) && (SocketOpen = 0) && (SocketBusy = 0) && (ReopenLeft <= 0)) {
			OpenSocket();
			ReopenLeft = 100;
		}
		If ((SocketOpen = 1) && (Announce_Interval > 0) && (AnnounceLeft <= 0) && (SocketBusy = 0)) {
			If (LooksLikeMAC(Mac) = 1) SendBroadcast(1);
			Else TRACE("[UDP]: Announce waiting for a MAC address");
			AnnounceLeft = Announce_Interval;
		}
		DELAY(1);
		AgeHolds(1);
		If (AnnounceLeft > 0) AnnounceLeft = AnnounceLeft - 1;
		If (ReopenLeft > 0) ReopenLeft = ReopenLeft - 1;
		If (ReplyWait > 0) ReplyWait = ReplyWait - 1;
	}
}
